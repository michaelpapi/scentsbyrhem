---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import Stage from '../components/Stage.astro';
import Catalogue from '../components/Catalogue.astro';
import CustomBand from '../components/CustomBand.astro';
import How from '../components/How.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Cart from '../components/Cart.astro';
import ProductDialog from '../components/ProductDialog.astro';
import CustomDialog from '../components/CustomDialog.astro';
import Confirm from '../components/Confirm.astro';
import { site, items, minPrice, clientData } from '../lib/data';

const { product } = Astro.props as { product?: string };
const it = product ? items.find((i) => i.id === product) : undefined;
const title = it ? `${it.name} | ${site.business.display}` : `${site.business.name} | ${site.business.tagline}`;
const description = it ? `${it.line} ${it.description}`.slice(0, 200) : site.business.description;
const path = it ? `/p/${it.id}/` : '/';
const image = it ? `/og/${it.id}.jpg` : '/og.png';
const ld = it ? JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Product', name: it.name, description: it.description, image: `${site.url}${image}`, brand: { '@type': 'Brand', name: site.business.display },
  offers: { '@type': 'AggregateOffer', priceCurrency: site.currency, lowPrice: minPrice(it), highPrice: Math.max(...Object.values(it.prices)), url: `${site.url}${path}` },
}) : '';
---
<Base title={title} description={description} path={path} image={image}>
  <Intro />
  <Header />
  <main>
    <Stage start={it?.id} />
    <Catalogue />
    <CustomBand />
    <How />
    <Faq />
  </main>
  <Footer />
  <Cart />
  <ProductDialog />
  <CustomDialog />
  <Confirm />
  {ld && <script is:inline type="application/ld+json" set:html={ld}></script>}
  <script is:inline type="application/json" id="site-data" set:html={JSON.stringify(clientData)}></script>
</Base>
