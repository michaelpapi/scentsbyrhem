---
import { site, categories, items, money, minPrice, catLabel } from '../lib/data';
const { start } = Astro.props as { start?: string };
const first = (start && items.find((i) => i.id === start)) || items[0];
const startId = start && items.some((i) => i.id === start) ? start : undefined;
const moodStyle = (k: string) => { const x = site.moods[k as keyof typeof site.moods]; return `--a:${x.a};--b:${x.b};--glow:${x.glow}`; };
const total = String(items.length).padStart(2, '0');
---
<section id="stage" class="stage dark" data-state={startId ? 'focus' : 'gallery'} data-start={startId} aria-labelledby="hero-title">
  <div class="stage-bg" aria-hidden="true">
    <div class="mood on" data-mood style={moodStyle(first.mood)}></div>
    <div class="mood" data-mood style={moodStyle(first.mood)}></div>
    <span class="bigword" data-bigword>Rhem</span>
    <div class="vignette"></div>
  </div>
  <div class="stage-view" data-view>
    <canvas class="gl" data-gl aria-hidden="true"></canvas>
    <div class="posters" data-posters></div>
    <div class="tags" data-tags aria-hidden="true"></div>
  </div>
  <p class="stage-status" data-status role="status"></p>
  <div class="stage-ui">
    <!-- gallery: every bottle floating -->
    <div class="g-layer" data-g-layer inert={!!startId} aria-hidden={startId ? 'true' : undefined}>
      <div class="hero-copy">
        <p class="eyebrow">Fine fragrance · by Rhema</p>
        <h1 id="hero-title">Wear your <em>signature.</em></h1>
        <p class="sub">Tap a bottle to step inside. Order on WhatsApp, or request any perfume we don't stock.</p>
      </div>
      <div class="g-zone" data-zone-g></div>
      <div class="dock">
        <div class="tabs" role="group" aria-label="Browse by category">
          <button type="button" class="tab" data-tab="all" aria-pressed="true">All</button>
          {categories.map((c) => <button type="button" class="tab" data-tab={c.id} aria-pressed="false">{c.label}</button>)}
        </div>
        <div class="gnote" data-gnote data-all-title={site.hero.title} data-all-text={site.hero.text}>
          <p class="kick" data-g-kick>{site.hero.kicker}</p>
          <h2 data-g-title>{site.hero.title}</h2>
          <p class="line" data-g-line>{site.hero.text}</p>
        </div>
        <ul class="picks" data-picks aria-label="Fragrances">
          {items.map((it) => <li><button type="button" data-pick={it.id}>{it.name}, {catLabel(it.category)}. Open</button></li>)}
        </ul>
        <p class="hint" data-hint>Tap a bottle to open it</p>
      </div>
    </div>

    <!-- focus: one bottle, big, with its story -->
    <div class="f-layer" data-f-layer inert={!startId} aria-hidden={startId ? undefined : 'true'}>
      <button type="button" class="f-close" data-f-close aria-label="Close and return to all fragrances">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <div class="f-zone" data-zone-f></div>
      <div class="f-body" data-f-body data-dir="1" aria-live="polite">
        <div class="f-top">
          <p class="f-count"><span data-f-n>01</span> / <span data-f-total>{total}</span> <i></i> <span data-f-cat>{catLabel(first.category)}</span></p>
          <button type="button" class="f-share" data-f-share aria-label="Share this fragrance"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5.5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="18.5" r="2.6"/><path d="M8.4 10.7l7.2-3.9M8.4 13.3l7.2 3.9"/></svg><span class="lbl">Share</span></button>
        </div>
        <h2 class="f-name"><span data-f-name>{first.name}</span></h2>
        <p class="f-line" data-f-line>{first.line}</p>
        <p class="f-desc" data-f-desc>{first.description}</p>
        <dl class="f-notes">
          <div><dt>Top</dt><dd data-f-top></dd></div>
          <div><dt>Heart</dt><dd data-f-heart></dd></div>
          <div><dt>Base</dt><dd data-f-base></dd></div>
        </dl>
        <div class="f-buy">
          <div class="f-sizes" data-f-sizes role="group" aria-label="Bottle size"></div>
          <b class="f-price" data-f-price>{money(minPrice(first))}</b>
        </div>
        <div class="f-actions">
          <button type="button" class="btn pink" data-f-add>Add to bag</button>
          <button type="button" class="btn ghost" data-f-look>Look closer</button>
        </div>
      </div>
      <div class="f-nav">
        <button type="button" class="pg" data-prev aria-label="Previous fragrance"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
        <div class="dots" data-dots role="group" aria-label="Choose a fragrance"></div>
        <button type="button" class="pg" data-next aria-label="Next fragrance"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
        <p class="f-swipe" aria-hidden="true">Swipe for the next</p>
      </div>
    </div>
  </div>
</section>
