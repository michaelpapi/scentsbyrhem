---
import Logo from './Logo.astro';
import { site, credits, waLink } from '../lib/data';
const year = new Date().getFullYear();
---
<footer class="sec foot tone-deep" id="contact">
  <div class="wrap">
    <div class="foot-grid">
      <div class="rv">
        <Logo />
        <p style="margin-top:1.2rem;max-width:26rem;opacity:.8">{site.business.description}</p>
        <form class="sub-form" id="sub-form" novalidate>
          <label class="sr" for="sub-contact">Your WhatsApp number or email</label>
          <div class="row">
            <input id="sub-contact" name="contact" autocomplete="email" inputmode="email" placeholder="WhatsApp number or email" maxlength="80" />
            <button type="submit" class="btn pink small">Join</button>
          </div>
          <p class="sub-note" data-sub-note role="status">New arrivals and offers, now and then.</p>
        </form>
      </div>
      <div class="rv" style="--i:1">
        <h4>Order</h4>
        <ul>
          <li><a href="#collection">The collection</a></li>
          <li><button type="button" class="linkbtn" style="padding:0;text-decoration:none;opacity:.85" data-open-custom>Custom order</button></li>
          <li><a href="#faq">Questions</a></li>
        </ul>
      </div>
      <div class="rv" style="--i:2">
        <h4>Talk to us</h4>
        <ul>
          <li><a href={waLink(`Hello ${site.business.name}!`)} target="_blank" rel="noopener">WhatsApp {site.contact.phoneDisplay}</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-base">
      <p class="credits">3D bottles:{" "}
        {credits.map((c, i) => <><a href={c.source} target="_blank" rel="noopener">{c.title}</a> by {c.authorUrl ? <a href={c.authorUrl} target="_blank" rel="noopener">{c.author}</a> : c.author} ({c.license}){i < credits.length - 1 ? '; ' : '.'}</>)}
      </p>
      <p style="margin:0">© {year} {site.business.name}</p>
    </div>
  </div>
</footer>
