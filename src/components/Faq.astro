---
import { faq } from '../lib/data';
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<section id="faq" class="sec tone-blush" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow">Questions</p>
      <h2 id="faq-title">Quick <em>answers.</em></h2>
    </div>
    <div class="faq rv">
      {faq.map((f) => <details name="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}></script>
</section>
