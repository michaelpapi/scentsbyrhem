---
import Logo from './Logo.astro';
---
<header class="top" id="top">
  <a href="#stage" class="logo-link" aria-label="ScentsByRhem, back to the top" style="text-decoration:none;color:inherit"><Logo /></a>
  <nav class="top-nav" aria-label="Sections">
    <a href="#collection">Collection</a>
    <a href="#custom">Custom order</a>
    <a href="#how">How it works</a>
    <a href="#faq">Questions</a>
  </nav>
  <div class="top-actions">
    <button type="button" class="btn ghost small" data-open-custom>Custom order</button>
    <button type="button" class="bag-btn" data-cart-open aria-haspopup="dialog" aria-label="Open your bag">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 8.5h13l-1 11.5h-11z" /><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" /></svg>
      <b data-count>0</b>
    </button>
  </div>
</header>
