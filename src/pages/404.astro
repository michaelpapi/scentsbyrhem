---
import Base from '../layouts/Base.astro';
import { site } from '../lib/data';
---
<Base title={`Page not found | ${site.business.name}`} description={site.business.description} path="/404.html" plain>
  <main class="lost">
    <p class="eyebrow">404</p>
    <h1>That page <em>drifted away.</em></h1>
    <p>The link may be old, or mistyped. The whole collection is one tap away.</p>
    <a class="btn pink" href="/">See the collection</a>
  </main>
  <style>
    .lost { min-height: 100svh; display: grid; align-content: center; justify-items: start; gap: 1rem; padding: 6rem var(--gutter); background: var(--deep); color: var(--blush); }
    .lost h1 { font-size: clamp(2.6rem, 9vw, 5rem); } .lost h1 em { color: var(--pink); }
  </style>
</Base>
